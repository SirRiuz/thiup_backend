# ============================================================
# Development dependencies
# ============================================================
# Inherits all production deps + adds test/dev tooling.
#
# Install locally or in the running container:
#     pip install -r requirements.dev
#     make dependencies-dev    # installs inside the web container
#
# The Docker image does NOT install this file — it stays out
# of production builds.
# ============================================================

# Inherit production deps.
-r requirements.in

