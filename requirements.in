# ============================================================
# Production dependencies — top-level only
# ============================================================
# This file declares the project's DIRECT dependencies.
# Versions use ranges (>=X.Y,<MAJOR+1) so patch/minor updates
# flow through without breaking the API contract.
#
# `requirements.txt` is regenerated from this file via:
#     make dependencies
# Do not edit `requirements.txt` by hand.
# ============================================================

# ─── Framework ──────────────────────────────────────────────
# Pinned to 4.x — project currently runs on Django 4.2 LTS.
# Bumping to 5.x is a deliberate migration, not an auto-upgrade.
Django>=4.2,<5.0

# ─── REST API ───────────────────────────────────────────────
djangorestframework>=3.14,<4.0
django-cors-headers>=4.3,<5.0

# ─── Database ───────────────────────────────────────────────
psycopg2>=2.9,<3.0

# ─── Storage (S3) ───────────────────────────────────────────
django-storages>=1.14,<2.0
boto3>=1.34

# ─── Security / auth ────────────────────────────────────────
PyJWT>=2.8,<3.0
pycryptodome>=3.20,<4.0

# ─── HTTP client ────────────────────────────────────────────
# Server-side siteverify call to the Cap captcha standalone
# (app/methods/captcha.py). Was previously only a transitive dep.
requests>=2.32,<3.0

# ─── Geolocation ────────────────────────────────────────────
# Only the LOCAL .mmdb reader is used (app/methods/location.py), so the raw
# maxminddb library suffices. The old geoip2 wrapper dragged in aiohttp (and
# its whole chain: multidict/yarl/frozenlist/aiosignal — ~15 MB and a
# recurring CVE-pinning burden) purely for its web-service client, which
# this app never calls.
maxminddb>=2.5,<3.0

# ─── Utilities ──────────────────────────────────────────────
# Country flag emoji in the admin's Mask list (app/admin.py). Pure python,
# a few KB.
emoji-country-flag>=1.3,<2.0

# ─── Config ─────────────────────────────────────────────────
python-decouple>=3.8,<4.0

# ─── Production server ──────────────────────────────────────
# Used by the prod image (ci/aws.Dockerfile); local dev uses runserver.
gunicorn>=21.0,<24.0

# Public uid generation (app/models/base_model.py) — runtime dependency.
# (Pillow / Faker / geonamescache moved to requirements.dev: nothing in the
# request path imports them — Pillow was a leftover of the removed
# Mask.icon ImageField, the other two only feed add_dummy_threads — and
# they added ~25+ MB to the image Fargate pulls on every scheduled tick.)
shortuuid>=1.0,<2.0
