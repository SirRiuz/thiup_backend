upstream django_backend {
    server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
}

server {
    listen ${SERVER_PORT};
    server_name _;
    # Must cover the largest allowed upload (UPLOAD_MAX_BYTES, default
    # 512 MB): the LOCAL presigned PUT goes through nginx and the old 80M
    # cap 413'd large videos. Prod uploads go straight to R2, never here.
    client_max_body_size 512M;

    proxy_read_timeout 90;
    proxy_connect_timeout 90;
    proxy_redirect off;
    # Pasamos $http_host (no $host) para preservar el puerto del cliente.
    # Con $host, Django recibe "localhost" sin puerto y construye URLs
    # absolutas rotas en la paginación (p.ej. next="http://localhost/threads/?page=2").
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # ── Anti-fingerprinting (defense-in-depth, no seguridad por sí sola) ──
    # server_tokens off: nginx no añade su versión al header Server.
    server_tokens off;
    # Ocultar el header Server del UPSTREAM (gunicorn/Django lo emiten y
    # delatan el stack). proxy_hide_header lo elimina de la respuesta
    # proxificada; nginx aún manda su propio "Server: nginx" — neutro y
    # sin versión gracias a server_tokens off. (Borrarlo del todo exige
    # el módulo headers-more, no estándar; "nginx" pelado no delata el
    # backend, que es lo que importa.)
    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;

    # collectstatic output — served by nginx when USE_AWS_STORAGE_SYSTEM=false.
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # User uploads — served by nginx when USE_AWS_STORAGE_SYSTEM=false.
    # When true, Django redirects to S3 directly.
    location /media/ {
        alias /app/media/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://django_backend;
    }

    # Errores de NGINX (5xx cuando el upstream cae): genéricos, sin
    # revelar tecnología. Los errores de aplicación los maneja Django con
    # DEBUG=False (sin stack trace ni branding).
    error_page 500 502 503 504 /50x_generic.html;
    location = /50x_generic.html {
        internal;
        default_type text/html;
        return 503 "<!doctype html><title>Unavailable</title><h1>Service temporarily unavailable</h1>";
    }
}
