#!/bin/bash

# Bridge command for the Thiup CI/CD cycle. Dispatches to subcommands:
#   build   -> build & push the image to ECR (delegates to build-base-image.sh)
#   deploy  -> force a new ECS deployment, wait for stable, print the public URL

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

################################################################################
# Configuration (override with flags)                                          #
################################################################################
CLUSTER="excited-eagle-q2rfm4-ds"
SERVICE="dsds"
REGION="us-east-1"
TIMEOUT=600
CONTAINER_PORT=8000
IMAGE_TAG="test"

################################################################################
# Dependency Verification                                                      #
################################################################################

dependency_verification() {
  MISSING_DEPENDENCIES=false
  # If you have any dependencies for your script, add the checks for them here:
  which aws > /dev/null
  if [[ $? -ne 0 ]]; then
    echo "AWS CLI ('aws') is required to run this script. Install it and run 'aws configure'."
    MISSING_DEPENDENCIES=true
  fi
  if [[ $MISSING_DEPENDENCIES == true ]]; then
    return 1
  fi
}

dependency_verification
MISSING_DEPENDENCIES=$?

# Set exit on error flag after dependency verification
set -e

if [[ $MISSING_DEPENDENCIES -ne 0 ]]; then
  exit 1;
fi

################################################################################
# Summary                                                                      #
################################################################################

summary() {
  # Display Summary
  # This string replacement is the name of the file/script
  echo "${0##*/}"
  echo "    Bridge command for the Thiup deploy cycle."
  echo ""
  echo "subcommands:"
  echo "    build    Build aws.Dockerfile and push the image to ECR."
  echo "    deploy   Force a new ECS deployment, wait, and print the public URL."
  echo ""
  echo "build and push the ':${IMAGE_TAG}' image:"
  echo "    bash scripts/ecs-deploy build --tag ${IMAGE_TAG}"
  echo ""
  echo "deploy the latest image to ECS:"
  echo "    bash scripts/ecs-deploy deploy"
}

################################################################################
# Help                                                                         #
################################################################################

help() {
   # Display Help
   summary
   echo ""
   echo "options:"
   echo "-h, --help           Print this help."
   echo "-s, --summary        Print a summary of the script."
   echo "    --tag            Image tag for 'build' (default: ${IMAGE_TAG})."
   echo "-c, --cluster        ECS cluster name for 'deploy' (default: ${CLUSTER})."
   echo "-n, --service        ECS service name for 'deploy' (default: ${SERVICE})."
   echo "-t, --timeout        Seconds to wait for the service to stabilize (default: ${TIMEOUT})."
   echo "-r, --region         AWS region (default: ${REGION})."
   echo ""
   echo "Requires AWS credentials configured locally (aws configure)."
}

################################################################################
# build (bridge to build-base-image.sh)                                        #
################################################################################

build() {
  bash "$SCRIPT_DIR/build-base-image.sh" --tag "$IMAGE_TAG" --region "$REGION"
}

################################################################################
# deploy                                                                       #
################################################################################

deploy() {
  echo "Forcing new deployment: cluster=${CLUSTER} service=${SERVICE} region=${REGION}"
  aws ecs update-service \
    --cluster "$CLUSTER" \
    --service "$SERVICE" \
    --force-new-deployment \
    --region "$REGION" > /dev/null

  echo "Waiting for the service to become stable (timeout ~${TIMEOUT}s)..."
  # 'wait services-stable' polls every 15s up to 40 times (~600s). The --timeout
  # flag is wired to the same intent: turn off -e so we can report a clean error.
  set +e
  timeout "$TIMEOUT" aws ecs wait services-stable \
    --cluster "$CLUSTER" \
    --services "$SERVICE" \
    --region "$REGION"
  WAIT_STATUS=$?
  set -e

  if [[ $WAIT_STATUS -ne 0 ]]; then
    echo "ERROR: the service did not stabilize within ${TIMEOUT}s." >&2
    echo "Check the ECS service events and the task logs in CloudWatch:" >&2
    echo "  aws ecs describe-services --cluster ${CLUSTER} --services ${SERVICE} --region ${REGION}" >&2
    exit 1
  fi

  echo "Service is stable. Resolving the running task's public IP..."

  TASK_ARN=$(aws ecs list-tasks \
    --cluster "$CLUSTER" \
    --service-name "$SERVICE" \
    --desired-status RUNNING \
    --region "$REGION" \
    --query 'taskArns[0]' \
    --output text)

  if [[ -z "$TASK_ARN" || "$TASK_ARN" == "None" ]]; then
    echo "ERROR: no RUNNING task found for service ${SERVICE}." >&2
    exit 1
  fi

  ENI_ID=$(aws ecs describe-tasks \
    --cluster "$CLUSTER" \
    --tasks "$TASK_ARN" \
    --region "$REGION" \
    --query "tasks[0].attachments[0].details[?name=='networkInterfaceId'].value | [0]" \
    --output text)

  PUBLIC_IP=$(aws ec2 describe-network-interfaces \
    --network-interface-ids "$ENI_ID" \
    --region "$REGION" \
    --query 'NetworkInterfaces[0].Association.PublicIp' \
    --output text)

  if [[ -z "$PUBLIC_IP" || "$PUBLIC_IP" == "None" ]]; then
    echo "Deployment succeeded, but the task has no public IP (private subnet?)." >&2
    echo "Task: ${TASK_ARN}" >&2
    exit 0
  fi

  echo ""
  echo "Deployment complete. App is reachable at:"
  echo "    http://${PUBLIC_IP}:${CONTAINER_PORT}"
}

################################################################################
# Main program                                                                 #
################################################################################
# Place your arg/flag related variables here at the top
HELP=false
SUMMARY=false
SUBCOMMAND=""

# First non-flag argument is the subcommand (build|deploy)
if [[ $# -gt 0 && "$1" != -* ]]; then
  SUBCOMMAND="$1"
  shift
fi

# For looping for access arg/flag input and making changes based off of them
while [[ $# -gt 0 ]]
do
  case $1 in
  -h|--help) HELP=true; shift ;;
  -s|--summary) SUMMARY=true; shift ;;
  --tag) IMAGE_TAG=$2; shift 2 ;;
  -c|--cluster) CLUSTER=$2; shift 2 ;;
  -n|--service) SERVICE=$2; shift 2 ;;
  -t|--timeout) TIMEOUT=$2; shift 2 ;;
  -r|--region) REGION=$2; shift 2 ;;
  *) echo "Unknown option: $1"; help; exit 1 ;;
  esac
done

if [[ $HELP == true ]]; then
  help
elif [[ $SUMMARY == true ]]; then
  summary
else
  case "$SUBCOMMAND" in
  build) build ;;
  deploy) deploy ;;
  "") help ;;
  *) echo "Unknown subcommand: $SUBCOMMAND"; help; exit 1 ;;
  esac
fi
