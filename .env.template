# ============================================================
# thiup_backend — environment configuration
# ============================================================
# Copy this file to `.env` and fill in real values.
# `.env` is NOT committed. This file IS.
# ============================================================

# ─── App ────────────────────────────────────────────────────
# Used as the prefix for container_names (${APP_NAME}_postgres, etc.).
APP_NAME=thiup

# ─── Server ─────────────────────────────────────────────────
# Single source of truth for the backend port.
# Propagates to Django runserver, nginx listen, host mapping, upstream.
# 8080 (y DB en 5433) para no chocar con otros proyectos locales que
# publican 8000/5432 en el host.
SERVER_PORT=8080

# ─── Django ─────────────────────────────────────────────────
# THE backend secret. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
# API_SECRET_KEY is NOT configured here: it is DERIVED from SECRET_KEY at boot
# (HMAC-SHA256, see core/settings.py). One secret to manage, same trust level.
SECRET_KEY=replace-me-with-a-long-random-string

# True in dev, False in prod.
DEBUG=True

# App-level toggles consumed by core/settings.py.
ENCRYPTED_RESPONSE=True
SINGLE_REQUEST_PROTECT=False

# Admin-only Swagger page (drf_yasg). Defaults to DEBUG: on locally, OFF in
# prod — the app costs ~10-20 MB of RSS per process just by importing it.
# ENABLE_SWAGGER=False

# Seed for the gateway rotating path (/{hash}/ = HMAC(seed, nonce)).
# PUBLIC obfuscation, NOT a secret (it also ships in the FE bundle) — kept
# independent from SECRET_KEY on purpose. REQUIRED (no default): the app
# refuses to boot without it. Must match the frontend's REACT_APP_GATEWAY_SEED.
GATEWAY_SEED=thiup-rotating-gateway-seed

# ─── Captcha (Cap standalone) ───────────────────────────────
# https://github.com/tiagozip/cap — invisible proof-of-work captcha. The FE
# widget solves challenges directly against the Cap server and exchanges the
# single-use token at POST /captcha/verify/ for a short-lived, mask-bound
# "human pass" (X-Human-Pass header) required by entity-creating writes.
# Locally `make up` starts the Cap server (`cap` + `valkey` services). With
# the flag off, the captcha layer is a no-op and the API behaves as before.
#
# ON by default, wired to the LOCAL Cap. LOCAL-DEV credentials only — never
# reuse them in prod (prod values live in SSM/Secrets Manager via the stack).
CAPTCHA_PROTECT=True
# Human-pass lifetime in seconds (default 600 = 10 min).
CAPTCHA_PASS_TTL=600
# THE single local knob: the Cap container listens on this port (its own
# SERVER_PORT) and publishes it 1:1; the backend derives both Cap URLs from
# it (http://cap:CAP_PORT internally, http://localhost:CAP_PORT for the
# browser). Change the port here and everything follows, log included.
CAP_PORT=3333
# Local dev site key. CAREFUL: a site key is a RECORD in Cap's store (the
# valkey_data volume), not just these env values — on a fresh clone/volume
# this key does not exist yet and every solve fails with "Invalid site key".
# Recreate it once: open http://localhost:3333, log in with CAP_ADMIN_KEY,
# create a key and paste its values here.
CAP_SITE_KEY=b586371459
CAP_SECRET=sk-8sMG6IbqlxHvAMO0iSrSqe3s7L4I2ZpGtvYNNNOxoio
# Admin key for the LOCAL Cap dashboard (login at http://localhost:3333).
# Dev-only convenience value (min 12 chars) — prod uses its own key in
# Secrets Manager (/${stack}/CAP_ADMIN_KEY), never this one.
CAP_ADMIN_KEY=thiup-local-cap-admin-key
# ─── Redis-compatible store ─────────────────────────────────
# Used by the Cap captcha only (Django stays Redis-free). Empty → the local
# `valkey` compose service. The store must persist with
# maxmemory-policy=noeviction — Cap's site keys live there.
REDIS_URL=
# Only for a Cap that does NOT live in this compose (e.g. prod): explicit
# URL overrides beat the CAP_PORT-derived defaults. Empty = use the derived
# defaults (http://cap:CAP_PORT / http://localhost:CAP_PORT).
CAP_SITEVERIFY_URL=
CAP_PUBLIC_URL=
# Per-IP rate limits for entity-creating writes (anti-abuse companion of the
# human pass; generous for humans, hard ceiling for scripts).
THROTTLE_THREADS=10/min
THROTTLE_REACTIONS=60/min
THROTTLE_CAPTCHA=20/min

# ─── Security: Hosts & Origins ──────────────────────────────
# These three lists serve DIFFERENT purposes with DIFFERENT formats.
# Mixing them up is the #1 source of CSRF/CORS bugs.
#
# ALLOWED_HOSTS
#   Anti Host-header attack. Django checks against the request's Host header.
#   Format: bare hostnames, comma-separated. NO scheme, NO port.
#   Wildcards allowed: *.thiup.com
#   Example: localhost,127.0.0.1,thiup.com,*.thiup.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF_TRUSTED_ORIGINS
#   Origins trusted for cross-origin POSTs (incl. admin login via nginx).
#   Format: full URLs with scheme AND port. Django 4+ matches EXACTLY.
#   Include each port you actually access the backend from.
#   Example: http://localhost:8000,http://localhost:3000,https://thiup.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000

# CORS_ALLOWED_ORIGINS
#   Origins permitted to make browser cross-origin requests to this backend.
#   Typical case: a separate frontend (Next.js on :3000) talking to :8000.
#   Same format as CSRF_TRUSTED_ORIGINS.
#   Note: CORS_ORIGIN_WHITELIST is the old, deprecated name — don't use it.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Production examples:
#   ALLOWED_HOSTS=thiup.com,www.thiup.com,api.thiup.com
#   CSRF_TRUSTED_ORIGINS=https://thiup.com,https://www.thiup.com,https://api.thiup.com
#   CORS_ALLOWED_ORIGINS=https://thiup.com,https://www.thiup.com

# ─── Internal URLs ──────────────────────────────────────────
# INTERNAL_ADMIN_URL — REQUIRED. App refuses to boot if missing/empty.
#   Path where the real Django admin lives. The literal "admin/" is reserved
#   for the honeypot decoy and is rejected at boot.
#   Generate a non-predictable value:
#     python -c "import secrets; print(f'admin-{secrets.token_urlsafe(6)}/')"
#   Example: INTERNAL_ADMIN_URL=admin-Hk9_x2lT/
INTERNAL_ADMIN_URL=

# INTERNAL_GRAPHQL_URL — path prefix for the GraphQL endpoint (if applicable).
INTERNAL_GRAPHQL_URL=graphql/

# ─── Database (PostgreSQL) ──────────────────────────────────
# Local: use "postgres" (the local container). External DB: use its endpoint,
# e.g. ...-pooler.us-east-1.aws.neon.tech
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_HOST=postgres
DATABASE_NAME=thiup
DATABASE_USER=thiup
DATABASE_PASSWORD=changeme-strong-password
DATABASE_PORT=5433

# ─── Media URLs ─────────────────────────────────────────────
# MEDIA_BASE_URL — origin (scheme + host[:port]) prefixed to local media URLs.
#   Only used when USE_AWS_STORAGE_SYSTEM=false; ignored on S3/R2 (the bucket
#   backend emits absolute URLs of its own).
#   No trailing slash. Examples:
#     dev:  http://localhost:8000
#     prod: https://api.tu-dominio.com
MEDIA_BASE_URL=http://localhost:8000

# ─── Object storage: S3-compatible (AWS S3 or Cloudflare R2) ─
# true  → uploads go to the bucket, media_volume unused.
# false → uploads go to /app/media (served by nginx).
USE_AWS_STORAGE_SYSTEM=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
# Public base for object references (CDN/custom domain). Also the base the
# presigned-upload flow returns as `public_url` for stored ThreadFile keys.
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=auto
# Upload-flow knobs. Read/defaulted in core/settings.py (single source of
# truth); these are optional overrides. (The object-key layout is hardcoded in
# settings.py — not configurable here.)
# General hard cap for ANY uploaded file (100 MB, DECIMAL 100,000,000 bytes —
# Cloudflare Media Transformations needs sources strictly under 100 MiB, so the
# round decimal cap leaves a ~4.5 MiB margin and matches the "100 MB" label the
# frontend shows). The frontend enforces finer per-type limits (image 8 MB /
# GIF 15 MB / video 100 MB); this is the real guard.
# NOTE: a web proxy in front (nginx/ALB) must allow at least this much, e.g.
#   nginx:  client_max_body_size 100M;  (100M = 100 MiB > this cap)
UPLOAD_PRESIGN_EXPIRES=600
UPLOAD_MAX_BYTES=100000000

# ─── Anti-fingerprinting ────────────────────────────────────────────
# Cookies con nombre genérico (evita delatar Django a Wappalyzer). El FE
# no lee estas cookies (API por header + E2E); el admin sigue OK.
CSRF_COOKIE_NAME=x_t
SESSION_COOKIE_NAME=x_s
