# ============================================================
# thiup_backend — environment configuration
# ============================================================
# Copy this file to `.env` and fill in real values.
# `.env` is NOT committed. This file IS.
# ============================================================

# ============================================================
# STAGE — runtime environment (CRITICAL)
# ============================================================
# Controls which services come up and how Django is configured.
#
# Valid values:
#
#   dev   → local development
#           - Brings up postgres + web + nginx
#           - Django DEBUG typically True
#           - manage.py runserver
#           - DATABASE_HOST must be "postgres" (the local container)
#
#   prod  → production
#           - Brings up ONLY web + nginx (postgres is external, e.g. RDS)
#           - Django DEBUG must be False
#           - DATABASE_HOST must be the external endpoint, e.g.
#             tudb.cluster-xxx.us-east-1.rds.amazonaws.com
#
# The Makefile translates STAGE → COMPOSE_PROFILES automatically.
# `make up-d` detects STAGE and brings up the matching service set.
# ============================================================
STAGE=dev

# ─── App ────────────────────────────────────────────────────
# Used as the prefix for container_names (${APP_NAME}_postgres, etc.).
APP_NAME=thiup

# ─── Server ─────────────────────────────────────────────────
# Single source of truth for the backend port.
# Propagates to Django runserver, nginx listen, host mapping, upstream.
# 8080 (y DB en 5433) para no chocar con otros proyectos locales que
# publican 8000/5432 en el host.
SERVER_PORT=8080

# ─── Django ─────────────────────────────────────────────────
# THE backend secret. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
# API_SECRET_KEY is NOT configured here: it is DERIVED from SECRET_KEY at boot
# (HMAC-SHA256, see core/settings.py). One secret to manage, same trust level.
SECRET_KEY=replace-me-with-a-long-random-string

# True in dev, False in prod.
DEBUG=True

# App-level toggles consumed by core/settings.py.
ENCRYPTED_RESPONSE=True
SINGLE_REQUEST_PROTECT=False

# Seed for the gateway rotating path (/{hash}/ = HMAC(seed, nonce)).
# PUBLIC obfuscation, NOT a secret (it also ships in the FE bundle) — kept
# independent from SECRET_KEY on purpose. REQUIRED (no default): the app
# refuses to boot without it. Must match the frontend's REACT_APP_GATEWAY_SEED.
GATEWAY_SEED=thiup-rotating-gateway-seed

# ─── Security: Hosts & Origins ──────────────────────────────
# These three lists serve DIFFERENT purposes with DIFFERENT formats.
# Mixing them up is the #1 source of CSRF/CORS bugs.
#
# ALLOWED_HOSTS
#   Anti Host-header attack. Django checks against the request's Host header.
#   Format: bare hostnames, comma-separated. NO scheme, NO port.
#   Wildcards allowed: *.thiup.com
#   Example: localhost,127.0.0.1,thiup.com,*.thiup.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF_TRUSTED_ORIGINS
#   Origins trusted for cross-origin POSTs (incl. admin login via nginx).
#   Format: full URLs with scheme AND port. Django 4+ matches EXACTLY.
#   Include each port you actually access the backend from.
#   Example: http://localhost:8000,http://localhost:3000,https://thiup.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000

# CORS_ALLOWED_ORIGINS
#   Origins permitted to make browser cross-origin requests to this backend.
#   Typical case: a separate frontend (Next.js on :3000) talking to :8000.
#   Same format as CSRF_TRUSTED_ORIGINS.
#   Note: CORS_ORIGIN_WHITELIST is the old, deprecated name — don't use it.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Production examples:
#   ALLOWED_HOSTS=thiup.com,www.thiup.com,api.thiup.com
#   CSRF_TRUSTED_ORIGINS=https://thiup.com,https://www.thiup.com,https://api.thiup.com
#   CORS_ALLOWED_ORIGINS=https://thiup.com,https://www.thiup.com

# ─── Internal URLs ──────────────────────────────────────────
# INTERNAL_ADMIN_URL — REQUIRED. App refuses to boot if missing/empty.
#   Path where the real Django admin lives. The literal "admin/" is reserved
#   for the honeypot decoy and is rejected at boot.
#   Generate a non-predictable value:
#     python -c "import secrets; print(f'admin-{secrets.token_urlsafe(6)}/')"
#   Example: INTERNAL_ADMIN_URL=admin-Hk9_x2lT/
INTERNAL_ADMIN_URL=

# INTERNAL_GRAPHQL_URL — path prefix for the GraphQL endpoint (if applicable).
INTERNAL_GRAPHQL_URL=graphql/

# ─── Database (PostgreSQL) ──────────────────────────────────
# STAGE=dev  → use "postgres" (the local container)
# STAGE=prod → use the external endpoint, e.g.
#              tudb.cluster-xxx.us-east-1.rds.amazonaws.com
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_HOST=postgres
DATABASE_NAME=thiup
DATABASE_USER=thiup
DATABASE_PASSWORD=changeme-strong-password
DATABASE_PORT=5433

# ─── Media URLs ─────────────────────────────────────────────
# MEDIA_BASE_URL — origin (scheme + host[:port]) prefixed to local media URLs.
#   Only used when USE_AWS_STORAGE_SYSTEM=false; ignored on S3/R2 (the bucket
#   backend emits absolute URLs of its own).
#   No trailing slash. Examples:
#     dev:  http://localhost:8000
#     prod: https://api.tu-dominio.com
MEDIA_BASE_URL=http://localhost:8000

# ─── AWS S3 (media storage) ─────────────────────────────────
# true  → uploads go to S3, media_volume unused.
# false → uploads go to /app/media (served by nginx).
USE_AWS_STORAGE_SYSTEM=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=

# ─── Servidor web del contenedor `web` ──────────────────────
# Sin definir → dev: runserver con autoreload.
# En producción (Raspberry) descomenta para servir con gunicorn
# (procesos/threads/reciclaje afinados en gunicorn.conf.py):
# WEB_COMMAND=gunicorn core.wsgi:application -c gunicorn.conf.py -b 0.0.0.0:${SERVER_PORT}

# ─── Anti-fingerprinting ────────────────────────────────────────────
# Cookies con nombre genérico (evita delatar Django a Wappalyzer). El FE
# no lee estas cookies (API por header + E2E); el admin sigue OK.
CSRF_COOKIE_NAME=x_t
SESSION_COOKIE_NAME=x_s
