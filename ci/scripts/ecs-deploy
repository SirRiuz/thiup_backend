#!/bin/bash

# Bridge command for the Thiup CI/CD cycle. Dispatches to subcommands:
#   build   -> build & push the image to ECR (delegates to build-base-image.sh)
#   deploy  -> force a new ECS deployment, wait for stable, print the public URL

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# No hardcoded configuration: every value is supplied as a flag (by buildspec.yml
# in CI, or by hand for local runs). require_vars below enforces that the values
# each subcommand needs are present.
#   build  needs: --account --region --image-name --tag --dockerfile
#   deploy needs: --cluster --service --region --timeout [--port]

# --- Dependency Verification ---
dependency_verification() {
  MISSING_DEPENDENCIES=false
  # If you have any dependencies for your script, add the checks for them here:
  which aws > /dev/null
  if [[ $? -ne 0 ]]; then
    echo "AWS CLI ('aws') is required to run this script. Install it and run 'aws configure'."
    MISSING_DEPENDENCIES=true
  fi
  # jq is used by 'collectstatic' to read the service network configuration.
  which jq > /dev/null
  if [[ $? -ne 0 ]]; then
    echo "jq is required to run this script (used by the collectstatic subcommand)."
    MISSING_DEPENDENCIES=true
  fi
  if [[ $MISSING_DEPENDENCIES == true ]]; then
    return 1
  fi
}

dependency_verification
MISSING_DEPENDENCIES=$?

# Set exit on error flag after dependency verification
set -e

if [[ $MISSING_DEPENDENCIES -ne 0 ]]; then
  exit 1;
fi

# --- Summary ---
summary() {
  # Display Summary
  # This string replacement is the name of the file/script
  echo "${0##*/}"
  echo "    Bridge command for the Thiup deploy cycle."
  echo ""
  echo "subcommands:"
  echo "    build          Build ci/aws.Dockerfile and push the image to ECR (mutable + immutable tag)."
  echo "    register-task  Clone the service's task def, swap the image to the immutable tag."
  echo "    collectstatic  Run-task that uploads static to S3."
  echo "    automigrate    Roll the DB back to the migration common to the DB and this branch."
  echo "    migrate        Apply this branch's migrations forward."
  echo "    deploy         Switch the service to the registered revision, wait, print the URL."
  echo ""
  echo "build and push an image (all values via flags):"
  echo "    bash ci/scripts/ecs-deploy build --account 123 --region us-east-1 \\"
  echo "      --image-name thiup-backend --tag test --dockerfile ci/aws.Dockerfile"
  echo ""
  echo "deploy the latest image to ECS:"
  echo "    bash ci/scripts/ecs-deploy deploy --cluster my-cluster --service my-svc \\"
  echo "      --region us-east-1 --timeout 600"
}

# --- Help ---
help() {
   # Display Help
   summary
   echo ""
   echo "options (no defaults; supplied by buildspec.yml in CI or by hand):"
   echo "-h, --help           Print this help."
   echo "-s, --summary        Print a summary of the script."
   echo "    --tag            Image tag for 'build'."
   echo "-a, --account        AWS account id for 'build'."
   echo "-i, --image-name     ECR image name for 'build'."
   echo "-f, --dockerfile     Dockerfile for 'build'."
   echo "-c, --cluster        ECS cluster name for 'deploy'."
   echo "-n, --service        ECS service name for 'deploy'."
   echo "-t, --timeout        Seconds to wait for the service to stabilize ('deploy')."
   echo "-p, --port           Container port for the printed URL ('deploy', optional)."
   echo "    --schedule       EventBridge schedule name to re-point at the new revision ('deploy', optional)."
   echo "-r, --region         AWS region."
   echo ""
   echo "Requires AWS credentials configured locally (aws configure)."
}

# --- Configuration validation ---
require_vars() {
  local missing=false
  local var
  for var in "$@"; do
    if [[ -z "${!var}" ]]; then
      echo "Missing required value: ${var}. Set it in buildspec.yml / the CodeBuild env or pass the matching flag (see -h)." >&2
      missing=true
    fi
  done
  if [[ $missing == true ]]; then
    exit 1
  fi
}

# --- build (bridge to build-base-image.sh) ---
build() {
  require_vars AWS_ACCOUNT_ID REGION IMAGE_NAME IMAGE_TAG DOCKERFILE
  local args=(--account "$AWS_ACCOUNT_ID" --region "$REGION" \
    --image-name "$IMAGE_NAME" --tag "$IMAGE_TAG" --dockerfile "$DOCKERFILE")
  [[ -n "$IMMUTABLE_TAG" ]] && args+=(--immutable-tag "$IMMUTABLE_TAG")
  bash "$SCRIPT_DIR/build-base-image.sh" "${args[@]}"
}

TASKDEF_ARN_FILE="${TASKDEF_ARN_FILE:-/tmp/thiup_taskdef.arn}"

# Task def to run one-off tasks against: explicit flag > file written by
# register-task (the freshly built image) > the service's current revision.
resolve_task_def() {
  if [[ -n "$TASK_DEFINITION" ]]; then echo "$TASK_DEFINITION"
  elif [[ -f "$TASKDEF_ARN_FILE" ]]; then cat "$TASKDEF_ARN_FILE"
  else
    aws ecs describe-services --cluster "$CLUSTER" --services "$SERVICE" --region "$REGION" \
      --query 'services[0].taskDefinition' --output text
  fi
}

# --- shared: run an ephemeral one-off task and block on its exit code ---
run_ephemeral() {
  local task_def="$1" command_json="$2" label="$3"
  echo "Running ${label} via run-task (task-def=${task_def})"

  local network_configuration overrides task_arn exit_code has_sidecar
  network_configuration=$(aws ecs describe-services \
    --cluster "$CLUSTER" --services "$SERVICE" --region "$REGION" \
    --query 'services[0].networkConfiguration' --output json | jq -c)

  # Neutralize the cloudflared sidecar when the task def carries one: these
  # one-off tasks replace gunicorn with a management command, so a live
  # connector would route tunnel traffic into a task with nothing on :8000.
  # "version" prints and exits 0 (ignored by the sidecar's RestartPolicy).
  # Conditional so the script also works on task defs without the sidecar.
  has_sidecar=$(aws ecs describe-task-definition --task-definition "$task_def" --region "$REGION" \
    --query 'length(taskDefinition.containerDefinitions[?name==`cloudflared`])' --output text)
  if [[ "$has_sidecar" != "0" ]]; then
    overrides=$(printf '{"containerOverrides":[{"name":"web","command":%s},{"name":"cloudflared","command":["version"]}]}' "$command_json")
  else
    overrides=$(printf '{"containerOverrides":[{"name":"web","command":%s}]}' "$command_json")
  fi

  task_arn=$(aws ecs run-task \
    --cluster "$CLUSTER" \
    --task-definition "$task_def" \
    --launch-type FARGATE \
    --network-configuration "$network_configuration" \
    --overrides "$overrides" \
    --region "$REGION" \
    --query 'tasks[0].taskArn' --output text)

  if [[ -z "$task_arn" || "$task_arn" == "None" ]]; then
    echo "ERROR: could not start the ${label} task." >&2
    exit 1
  fi

  echo "Waiting for ${label}: ${task_arn}"
  aws ecs wait tasks-stopped --cluster "$CLUSTER" --tasks "$task_arn" --region "$REGION"

  exit_code=$(aws ecs describe-tasks \
    --cluster "$CLUSTER" --tasks "$task_arn" --region "$REGION" \
    --query 'tasks[0].containers[?name==`web`].exitCode | [0]' --output text)

  if [[ "$exit_code" != "0" ]]; then
    echo "ERROR: ${label} exited with code ${exit_code}. Check CloudWatch logs." >&2
    exit 1
  fi
  echo "${label} OK."
}

# --- register-task (clone current task def, swap image to the immutable tag) ---
register_task() {
  require_vars AWS_ACCOUNT_ID REGION IMAGE_NAME IMMUTABLE_TAG CLUSTER SERVICE
  local image current new_def new_arn
  image="${AWS_ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com/${IMAGE_NAME}:${IMMUTABLE_TAG}"

  current=$(aws ecs describe-services --cluster "$CLUSTER" --services "$SERVICE" --region "$REGION" \
    --query 'services[0].taskDefinition' --output text)
  new_def=$(aws ecs describe-task-definition --task-definition "$current" --region "$REGION" \
    --query 'taskDefinition' --output json \
    | jq --arg IMG "$image" '
        .containerDefinitions = (.containerDefinitions
          | map(if .name=="web" then .image=$IMG else . end))
        | del(.taskDefinitionArn, .revision, .status, .requiresAttributes,
              .compatibilities, .registeredAt, .registeredBy)')

  new_arn=$(aws ecs register-task-definition --region "$REGION" \
    --cli-input-json "$new_def" \
    --query 'taskDefinition.taskDefinitionArn' --output text)

  if [[ -z "$new_arn" || "$new_arn" == "None" ]]; then
    echo "ERROR: failed to register a new task definition revision." >&2
    exit 1
  fi
  echo "$new_arn" > "$TASKDEF_ARN_FILE"
  echo "Registered task definition ${new_arn} (image tag ${IMMUTABLE_TAG})"
}

# --- collectstatic (ephemeral run-task that uploads static to S3) ---
collectstatic() {
  require_vars CLUSTER SERVICE REGION
  run_ephemeral "$(resolve_task_def)" \
    '["python","manage.py","collectstatic","--noinput"]' "collectstatic"
}

# --- migrate (apply this branch's migrations forward) ---
migrate() {
  require_vars CLUSTER SERVICE REGION
  run_ephemeral "$(resolve_task_def)" \
    '["python","manage.py","migrate","--noinput"]' "migrate"
}

# --- automigrate (roll the DB back to the common ancestor; runs on the OLD image) ---
automigrate() {
  require_vars CLUSTER SERVICE REGION
  python3 "$SCRIPT_DIR/automigrate.py" \
    --cluster "$CLUSTER" --service "$SERVICE" --region "$REGION"
}

# --- re-point the momentum schedule at the just-deployed revision (post-migrate) ---
update_momentum_schedule() {
  local task_def="$1"
  [[ -z "$MOMENTUM_SCHEDULE" ]] && return 0
  echo "Re-pointing momentum schedule ${MOMENTUM_SCHEDULE} at ${task_def}"
  local tmp
  tmp=$(mktemp)
  aws scheduler get-schedule --name "$MOMENTUM_SCHEDULE" --region "$REGION" --output json \
    | jq --arg ARN "$task_def" '
        .Target.EcsParameters.TaskDefinitionArn = $ARN
        | del(.Arn, .CreationDate, .LastModificationDate)' > "$tmp"
  aws scheduler update-schedule --region "$REGION" --cli-input-json "file://$tmp" > /dev/null
  rm -f "$tmp"
  echo "Momentum schedule now runs the deployed revision."
}

# --- deploy (switch the service to the freshly registered revision) ---
deploy() {
  require_vars CLUSTER SERVICE REGION TIMEOUT
  local task_def
  task_def=$(resolve_task_def)
  echo "Deploying ${task_def} to cluster=${CLUSTER} service=${SERVICE} region=${REGION}"
  aws ecs update-service \
    --cluster "$CLUSTER" \
    --service "$SERVICE" \
    --task-definition "$task_def" \
    --region "$REGION" > /dev/null

  update_momentum_schedule "$task_def"

  echo "Waiting for the service to become stable (timeout ~${TIMEOUT}s)..."
  # 'wait services-stable' polls every 15s up to 40 times (~600s). The --timeout
  # flag is wired to the same intent: turn off -e so we can report a clean error.
  set +e
  timeout "$TIMEOUT" aws ecs wait services-stable \
    --cluster "$CLUSTER" \
    --services "$SERVICE" \
    --region "$REGION"
  WAIT_STATUS=$?
  set -e

  if [[ $WAIT_STATUS -ne 0 ]]; then
    echo "ERROR: the service did not stabilize within ${TIMEOUT}s." >&2
    echo "Check the ECS service events and the task logs in CloudWatch:" >&2
    echo "  aws ecs describe-services --cluster ${CLUSTER} --services ${SERVICE} --region ${REGION}" >&2
    exit 1
  fi

  echo "Service is stable. Resolving the running task's public IP..."

  TASK_ARN=$(aws ecs list-tasks \
    --cluster "$CLUSTER" \
    --service-name "$SERVICE" \
    --desired-status RUNNING \
    --region "$REGION" \
    --query 'taskArns[0]' \
    --output text)

  if [[ -z "$TASK_ARN" || "$TASK_ARN" == "None" ]]; then
    echo "ERROR: no RUNNING task found for service ${SERVICE}." >&2
    exit 1
  fi

  ENI_ID=$(aws ecs describe-tasks \
    --cluster "$CLUSTER" \
    --tasks "$TASK_ARN" \
    --region "$REGION" \
    --query "tasks[0].attachments[0].details[?name=='networkInterfaceId'].value | [0]" \
    --output text)

  PUBLIC_IP=$(aws ec2 describe-network-interfaces \
    --network-interface-ids "$ENI_ID" \
    --region "$REGION" \
    --query 'NetworkInterfaces[0].Association.PublicIp' \
    --output text)

  if [[ -z "$PUBLIC_IP" || "$PUBLIC_IP" == "None" ]]; then
    echo "Deployment succeeded, but the task has no public IP (private subnet?)." >&2
    echo "Task: ${TASK_ARN}" >&2
    exit 0
  fi

  echo ""
  echo "Deployment complete. App is reachable at:"
  if [[ -n "$CONTAINER_PORT" ]]; then
    echo "    http://${PUBLIC_IP}:${CONTAINER_PORT}"
  else
    echo "    http://${PUBLIC_IP}"
  fi
}

# --- Main program ---
# Place your arg/flag related variables here at the top
HELP=false
SUMMARY=false
SUBCOMMAND=""

# First non-flag argument is the subcommand (build|deploy)
if [[ $# -gt 0 && "$1" != -* ]]; then
  SUBCOMMAND="$1"
  shift
fi

# For looping for access arg/flag input and making changes based off of them
while [[ $# -gt 0 ]]
do
  case $1 in
  -h|--help) HELP=true; shift ;;
  -s|--summary) SUMMARY=true; shift ;;
  --tag) IMAGE_TAG=$2; shift 2 ;;
  --immutable-tag) IMMUTABLE_TAG=$2; shift 2 ;;
  --task-definition) TASK_DEFINITION=$2; shift 2 ;;
  --schedule) MOMENTUM_SCHEDULE=$2; shift 2 ;;
  -a|--account) AWS_ACCOUNT_ID=$2; shift 2 ;;
  -i|--image-name) IMAGE_NAME=$2; shift 2 ;;
  -f|--dockerfile) DOCKERFILE=$2; shift 2 ;;
  -c|--cluster) CLUSTER=$2; shift 2 ;;
  -n|--service) SERVICE=$2; shift 2 ;;
  -t|--timeout) TIMEOUT=$2; shift 2 ;;
  -p|--port) CONTAINER_PORT=$2; shift 2 ;;
  -r|--region) REGION=$2; shift 2 ;;
  *) echo "Unknown option: $1"; help; exit 1 ;;
  esac
done

if [[ $HELP == true ]]; then
  help
elif [[ $SUMMARY == true ]]; then
  summary
else
  case "$SUBCOMMAND" in
  build) build ;;
  register-task) register_task ;;
  collectstatic) collectstatic ;;
  automigrate) automigrate ;;
  migrate) migrate ;;
  deploy) deploy ;;
  "") help ;;
  *) echo "Unknown subcommand: $SUBCOMMAND"; help; exit 1 ;;
  esac
fi
